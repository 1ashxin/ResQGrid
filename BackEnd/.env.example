# WHAT THIS FILE DOES (plain English):
# This is a TEMPLATE for your local secrets file. Copy this file to ".env"
# (a new file, in the same folder) and fill in real values there. The real
# ".env" file should never be committed to git -- .gitignore should already
# be set up to exclude it.

# Connection string for PostgreSQL:
# postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resqgrid

# Secret key used to encrypt/decrypt victim PII (name, phone, description).
# Generate one by running this in your terminal:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this secret. Every environment (dev/staging/prod) should have its own
# key -- do not reuse a development key in production.
FERNET_KEY=replace-with-a-generated-key
